NODE_ENV=staging
PORT=4000
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DATABASE>?sslmode=require
AI_MODE=mock
LOG_LEVEL=info
API_BASE_URL=https://api-staging.example.com
WEB_ORIGIN=https://staging.example.com
ADMIN_ORIGIN=https://admin-staging.example.com
AI_PROVIDER_KEY=external
AI_PROVIDER_ENDPOINT=
AI_PROVIDER_API_KEY=
AI_MODEL=staging-default
AI_TIMEOUT_MS=8000
AI_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=30000
